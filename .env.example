DATABASE_URL=postgres://user:password@host/database
ADMIN_USERNAME=admin
# Generate with: npm run auth:hash-password -- 'your-password'
# Escape each `$` because Next.js expands unescaped dollar references.
ADMIN_PASSWORD_HASH=scrypt\$salt\$derived-key
# Optional: your Catbox account userhash, so deleted books are removed from Catbox too.
CATBOX_USERHASH=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
